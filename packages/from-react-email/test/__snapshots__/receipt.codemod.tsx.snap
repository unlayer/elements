          backgroundColor="#111827"
          padding="24px 32px 24px 32px"
          borderRadius="8px 8px 0px 0px"
        >
          <Image
            src={{
              url: "https://placehold.co/140x36/111827/ffffff?text=Northwind",
              width: 140,
              height: 36,
            }}
            width="140px"
            alt="Northwind"
            textAlign="left"
            containerPadding="0px 0px 0px 0px"
            mobile={{ width: "140px" }}
          />
        </Column>
      </Row>
      <Row>
        <Column backgroundColor="#ffffff" padding="32px 0px 24px 0px">
          <Heading
            headingType="h1"
            color="#111827"
            fontSize="24px"
            lineHeight="32px"
            fontWeight={700}
            containerPadding="0px 32px 12px 32px"
          >
            Thanks for your order, {customerName}!
          </Heading>
          <Paragraph
            color="#4b5563"
            fontSize="15px"
            lineHeight="24px"
            containerPadding="0px 32px 0px 32px"
          >
            We've received your payment and are getting your order ready. Here's your receipt for
            your records.
          </Paragraph>
        </Column>
      </Row>
      <Row cells={[32, 184, 168, 184, 32]} noStackMobile={true}>
        <Column backgroundColor="#ffffff">
          <Divider borderTopWidth="0px" containerPadding="0px" />
        </Column>
        <Column backgroundColor="#f9fafb" padding="8px 0px 8px 16px" borderRadius="6px 0px 0px 6px">
          <Paragraph
            color="#6b7280"
            fontSize="11px"
            lineHeight="24px"
            fontWeight={600}
            letterSpacing="0.05em"
            html={`<span style="text-transform:uppercase">Order number</span>`}
            containerPadding="8px 0px 2px 0px"
          />
          <Paragraph
            color="#111827"
            fontSize="14px"
            lineHeight="24px"
            containerPadding="0px 0px 8px 0px"
          >
            #{orderNumber}
          </Paragraph>
        </Column>
        <Column backgroundColor="#f9fafb" padding="8px 0px 8px 0px">
          <Paragraph
            color="#6b7280"
            fontSize="11px"
