        </Column>
      </Row>
      <Row layout={ColumnLayouts.TwoEqual} noStackMobile={true}>
        <Column backgroundColor="#ffffff">
          <Paragraph
            color="#6b7280"
            fontSize="14px"
            lineHeight="24px"
            containerPadding="4px 0px 4px 32px"
          >
            Tax ({(taxRate * 100).toFixed(2)}%)
          </Paragraph>
        </Column>
        <Column backgroundColor="#ffffff">
          <Paragraph
            color="#111827"
            fontSize="14px"
            lineHeight="24px"
            textAlign="right"
            containerPadding="4px 32px 4px 0px"
          >
            {formatMoney(tax, currency)}
          </Paragraph>
        </Column>
      </Row>
      <Row>
        <Column backgroundColor="#ffffff" padding="20px 0px 0px 0px">
          <Divider
            borderTopWidth="1px"
            borderTopStyle="solid"
            borderTopColor="#e5e7eb"
            width="100%"
            containerPadding="0px 32px 0px 32px"
          />
        </Column>
      </Row>
      <Row layout={ColumnLayouts.TwoEqual} noStackMobile={true}>
        <Column backgroundColor="#ffffff" padding="20px 0px 0px 0px">
          <Paragraph
            color="#111827"
            fontSize="16px"
            lineHeight="24px"
            fontWeight={700}
            containerPadding="4px 0px 4px 32px"
