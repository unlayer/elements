// Migrated from React Email by @unlayer/from-react-email (codemod mode).
import {
  Button,
  Column,
  ColumnLayouts,
  Divider,
  Email,
  Heading,
  Image,
  Paragraph,
  Row,
} from "@unlayer/react-elements";
import { renderToStaticMarkup as reactStaticMarkup } from "react-dom/server";
import * as React from "react";

interface ReceiptItem {
  name: string;
  description?: string;
  quantity: number;
  unitPrice: number;
  imageUrl: string;
}

interface ReceiptEmailProps {
  customerName: string;
  orderNumber: string;
  orderDate: string;
  paymentMethod: string;
  items: ReceiptItem[];
  shipping: number;
  taxRate: number;
  currency?: string;
  orderUrl: string;
}

const formatMoney = (amount: number, currency = "USD") =>
  new Intl.NumberFormat("en-US", { style: "currency", currency }).format(amount);

export const ReceiptEmail = ({
  customerName,
  orderNumber,
  orderDate,
  paymentMethod,
  items,
  shipping,
  taxRate,
  currency = "USD",
  orderUrl,
}: ReceiptEmailProps) => {
  const subtotal = items.reduce((sum, item) => sum + item.quantity * item.unitPrice, 0);
  const tax = subtotal * taxRate;
  const total = subtotal + shipping + tax;

  return (
    <Email
      backgroundColor="#f3f4f6"
      contentWidth="600px"
      fontFamily={{
        label: "-apple-system",
        value:
          "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif",
      }}
      previewText={`Your receipt for order #${plainText(orderNumber)} - ${plainText(formatMoney(total, currency))}`}
    >
      <Row padding="40px 0px 0px 0px">
