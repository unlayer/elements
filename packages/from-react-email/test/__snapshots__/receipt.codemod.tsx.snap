          padding="20px 0px 38px 0px"
          borderRadius="0px 0px 8px 8px"
        >
          <Divider
            borderTopWidth="1px"
            borderTopStyle="solid"
            borderTopColor="#e5e7eb"
            width="100%"
            containerPadding="0px 32px 20px 32px"
          />
          <Paragraph
            color="#9ca3af"
            fontSize="12px"
            lineHeight="18px"
            textAlign="center"
            html={`Need help with your order? Visit our <a href="https://northwind.example.com/help" style="color:#6b7280;text-decoration-line:none;text-decoration:underline" target="_blank">help center</a> or reply to this email.`}
            containerPadding="0px 32px 6px 32px"
          />
          <Paragraph
            color="#9ca3af"
            fontSize="12px"
            lineHeight="18px"
            textAlign="center"
            containerPadding="0px 32px 0px 32px"
          >
            Northwind Traders · 500 Harbor Way · Seattle, WA 98101
