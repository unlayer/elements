{
  "name": "@unlayer-internal/elements-core",
  "version": "0.0.0",
  "private": true,
  "description": "The Elements document model, component definitions, validation and layout resolution (framework-neutral)",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
