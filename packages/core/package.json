{
  "name": "@unlayer-internal/elements-core",
  "version": "0.0.0",
  "private": true,
  "description": "The Elements engine: the document model, component definitions, validation, layout resolution, and the writers (web, email and print HTML, plain text); framework-neutral, apart from the ./pdf and ./image entries, which draw with react-pdf, Satori and resvg",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "require": "./dist/image.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/browser/tsconfig.json"
  },
  "devDependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/jsdom": "27.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.3",
    "jsdom": "24.1.3",
    "playwright": "1.60.0",
    "react": "^18.3.1",
    "satori": "0.33.5",
    "tsup": "^8.0.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
