{
  "name": "@unlayer-internal/elements-core",
  "version": "0.0.0",
  "private": true,
  "description": "The Elements engine: the document model, component definitions, validation, layout resolution, and the writers (web, email and print HTML, plain text); framework-neutral",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/browser/tsconfig.json"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "jsdom": "24.1.3",
    "playwright": "1.60.0",
    "tsup": "^8.0.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
