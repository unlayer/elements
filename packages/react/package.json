{
  "name": "@unlayer/react-elements",
  "version": "0.3.0",
  "description": "React components for transactional emails, landing pages, invoices and PDFs: email-safe HTML, responsive web HTML, and print-ready PDF HTML from one component tree.",
  "license": "MIT",
  "author": "Unlayer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unlayer/elements.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/unlayer/elements",
  "keywords": [
    "email",
    "react-email",
    "email-components",
    "html-email",
    "email-templates",
    "react-components",
    "email-builder",
    "server-components",
    "ssr",
    "unlayer",
    "transactional-email",
    "invoice",
    "pdf",
    "landing-page",
    "nextjs"
  ],
  "sideEffects": [
    "./dist/tailwind.js",
    "./dist/tailwind.cjs"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4.0.0",
    "prettier": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "@unlayer/exporters": "catalog:",
    "@unlayer/types": "catalog:"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./font": {
      "types": "./dist/font.d.ts",
      "import": "./dist/font.js",
      "require": "./dist/font.cjs"
    },
    "./head": {
      "types": "./dist/head.d.ts",
      "import": "./dist/head.js",
      "require": "./dist/head.cjs"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js",
      "require": "./dist/code.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js",
      "require": "./dist/async.cjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js",
      "require": "./dist/codegen.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:browser-runtime": "node scripts/browser-runtime-probe.mjs",
    "test:csp": "node --disallow-code-generation-from-strings scripts/csp-probe.mjs",
    "test:e2e": "node scripts/browser-e2e.mjs",
    "test:visual": "node scripts/storybook-visual.mjs",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"pnpm build-storybook --quiet && http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && pnpm test-storybook\""
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.1",
    "@storybook/addon-onboarding": "^9.1.1",
    "@storybook/react-vite": "^9.1.1",
    "@storybook/test-runner": "0.23.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@unlayer-internal/shared-elements": "workspace:*",
    "@unlayer/react-elements-previous": "npm:@unlayer/react-elements@0.1.22",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "9.2.1",
    "highlight.js": "11.12.0",
    "http-server": "14.1.1",
    "jsdom": "^24.1.3",
    "marked": "18.0.14",
    "playwright": "1.60.0",
    "prettier": "3.6.2",
    "storybook": "^9.1.1",
    "tailwindcss": "4.2.1",
    "tsup": "^8.0.1",
    "vitest": "^3.2.4",
    "wait-on": "9.0.10"
  }
}
