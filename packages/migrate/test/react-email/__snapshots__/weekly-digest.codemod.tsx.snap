              <Text
                style={{
                  padding: "0px 0px 0px 0px",
                  fontSize: 14,
                  color: "#000000",
                  lineHeight: "24px",
                }}
              >
                {article.url ? (
                  <Link
                    href={{ href: article.url, target: "_blank" }}
                    style={{
                      color: "rgb(79,57,246)",
