              lineHeight: "normal",
            }}
          >
            Welcome to {productName}
          </Heading>
          <Text
            style={{
              padding: "0px 0px 16px 0px",
              fontSize: 15,
              color: "#364153",
              lineHeight: "24px",
            }}
          >
            Hi {firstName},
          </Text>
          <Text
            style={{
              padding: "0px 0px 0px 0px",
              fontSize: 15,
              color: "#364153",
              lineHeight: "24px",
            }}
          >
            Thanks for signing up! Your workspace is ready and you can start building right away.
            Here are three quick things to try on your first day:
          </Text>
          <Text
            style={{
              padding: "16px 0px 0px 0px",
              fontSize: 15,
              color: "#364153",
              lineHeight: "28px",
            }}
          >
            1. Create your first project
          </Text>
          <Text
            style={{
              padding: "0px 0px 0px 0px",
              fontSize: 15,
              color: "#364153",
              lineHeight: "28px",
            }}
          >
            2. Invite your teammates
          </Text>
          <Text
            style={{
              padding: "0px 0px 0px 0px",
              fontSize: 15,
              color: "#364153",
              lineHeight: "28px",
            }}
          >
            3. Connect your favorite integrations
          </Text>
          <Column style={{ padding: "28px 0px 0px 0px", alignItems: "center" }}>
            <Button
              href={{ href: dashboardUrl, target: "_blank" }}
              style={{
                backgroundColor: "#4f39f6",
                color: "#ffffff",
                fontSize: 15,
                fontWeight: 600,
                lineHeight: "120%",
                padding: "12px 24px 12px 24px",
                borderRadius: 6,
