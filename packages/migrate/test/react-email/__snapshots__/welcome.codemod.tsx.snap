      </Section>
      <Section style={{ padding: [0, 0, 40, 0] }}>
        <Column
          style={{
            padding: "28px 32px 48px 32px",
            backgroundColor: "#ffffff",
            borderRadius: [0, 0, 8, 8],
          }}
        >
          <Text
            style={{
              padding: "0px 0px 16px 0px",
              fontSize: 15,
              color: "#364153",
              lineHeight: "24px",
            }}
          >
            {"Want to dig deeper? Our "}
            {docsUrl ? (
              <Link
                href={{ href: docsUrl, target: "_blank" }}
                style={{ color: "rgb(79,57,246)", textDecoration: "underline" }}
              >
                documentation
              </Link>
            ) : (
              <Span style={{ color: "rgb(79,57,246)", textDecoration: "underline" }}>
                documentation
              </Span>
            )}
            {" covers everything from quickstarts to advanced guides."}
          </Text>
          <Divider style={{ borderTop: "1px solid #e5e7eb", padding: "10px 0px 26px 0px" }} />
          <Text
