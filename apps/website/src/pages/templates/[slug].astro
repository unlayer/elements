---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Preview from "../../components/Preview.astro";
import { templates, thumbWidth, type Example } from "../../lib/examples";

export function getStaticPaths() {
  return templates.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Example };
const others = templates.filter((o) => o.slug !== t.slug);
const isDoc = t.root === "Document";
const isCanvas = t.root === "Canvas";
// A Document shows its print HTML and its real PDF, and a Canvas its real PNG; an Email or a Page its HTML, on a phone too, and as text.
const views = isDoc
  ? (["desktop", "pdf", "outline", "diagnostics"] as const)
  : isCanvas
    ? (["image", "outline", "diagnostics"] as const)
    : (["desktop", "phone", "text", "outline", "diagnostics", "html"] as const);
const name = t.source.match(/export default function (\w+)/)?.[1] ?? "Template";
const renderSnippet = isDoc
  ? `import { renderPdf } from "@hyper-elements/react/pdf";\nimport ${name} from "./${t.slug}";\n\nconst { pdf } = await renderPdf(<${name} />);`
  : isCanvas
  ? `import { renderImage } from "@hyper-elements/react/image";\nimport ${name} from "./${t.slug}";\n\n// fonts: the font files the card uses, as bytes ({ family, src, weight? })\nconst { image } = await renderImage(<${name} />, { fonts });`
  : `import { render } from "@hyper-elements/react";\nimport ${name} from "./${t.slug}";\n\nconst { html, text } = await render(<${name} />);`;
---
<Base title={`${t.title} template`} description={t.description}>
  <section class="t-hero">
    <div class="wrap">
      <a class="back" href="/templates">← Templates</a>
      <div class="t-head">
        <div>
          <h1 class="h-page" style="margin:0 0 10px">{t.title}</h1>
          <p class="lede">{t.description}</p>
        </div>
        <span class="chip">{`<${t.root}>`}</span>
      </div>
    </div>
  </section>
  <div class="wrap t-body">
    <div class="t-preview panel">
      <Preview example={t} height={isDoc ? 860 : isCanvas ? 640 : 760} width={thumbWidth(t, { page: 1200, document: 820, email: 680 })} views={views} />
    </div>
    <div class="t-code">
      <CodeBlock code={t.source} file={`${t.slug}.tsx`} />
      <CodeBlock code={renderSnippet} file="render.ts" />
    </div>
  </div>
  <section class="wrap more">
    <h2 class="cg-title">More templates</h2>
    <div class="more-list">
      {others.map((o) => <a class="chip" href={`/templates/${o.slug}`}>{o.title}</a>)}
    </div>
  </section>
</Base>

<style>
  .t-hero { padding: 48px 0 32px; }
  .back { color: var(--text-3); text-decoration: none; font-size: 14px; display: inline-block; margin-bottom: 20px; }
  .back:hover { color: var(--text); }
  .t-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .t-body { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .t-preview { overflow: hidden; background: #0e0e0e; position: sticky; top: calc(var(--header) + 16px); }
  .t-code { display: grid; gap: 16px; min-width: 0; }
  /* The PDF takes the page's width, with the code out of the way, so its pages are easy to read. */
  .t-body:has([data-preview][data-active="pdf"]) { grid-template-columns: minmax(0, 1fr); }
  .t-body:has([data-preview][data-active="pdf"]) .t-code { display: none; }
  .t-body:has([data-preview][data-active="pdf"]) .t-preview { position: static; }
  .more { margin-top: 64px; }
  .cg-title { font: 500 12.5px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); margin: 0 0 16px; }
  .more-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .more-list a { text-decoration: none; }
  .more-list a:hover { color: var(--text); border-color: var(--line-3); }
  @media (max-width: 1000px) {
    .t-body { grid-template-columns: minmax(0, 1fr); }
    .t-preview { position: static; }
    .t-head { flex-direction: column; align-items: flex-start; }
  }
</style>
