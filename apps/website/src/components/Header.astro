---
import Logo from "./Logo.astro";
import { mainNav, site } from "../lib/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => path === href || path.startsWith(href + "/");

// The repo's star count, read when the site is built. Until the repository is public there's none,
// and the link shows without a number.
let stars: string | null = null;
try {
  const res = await fetch(`https://api.github.com/repos/${site.repo}`, { signal: AbortSignal.timeout(3000), headers: { accept: "application/vnd.github+json" } });
  if (res.ok) {
    const n = (await res.json()).stargazers_count as number;
    stars = n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n);
  }
} catch {
  /* offline or not public yet */
}
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Hyper Elements home"><Logo size={28} /><span>Hyper Elements</span></a>
    <a class="version" href={site.releases} title="Release notes">v{site.version}</a>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      {mainNav.map((item) => (
        <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="search-btn" type="button" data-search-open aria-label="Search the docs">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="label">Search docs</span><kbd>⌘K</kbd>
      </button>
      <a class="icon-link" href={site.github} aria-label={stars ? `GitHub, ${stars} stars` : "GitHub"}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
        {stars && <span class="stars">{stars}</span>}
      </a>
      <button class="icon-link theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark">
        <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn btn-primary btn-sm" href="/docs/quickstart">Get started</a>
      <button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<dialog class="search-dialog" data-search aria-label="Search the docs">
  <input type="search" placeholder="Search docs and components…" aria-label="Search" autocomplete="off" data-search-input />
  <ul class="search-results" data-search-results></ul>
</dialog>
